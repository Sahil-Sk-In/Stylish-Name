<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/crunchRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5E6E8"
    android:orientation="vertical">

    <!-- Header -->
    <LinearLayout
        android:id="@+id/crunchHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvCrunchTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Style Generator (Crunch)"
            android:textColor="#E8B4B8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etCrunchName"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="2"
                android:background="@drawable/bg_editor_white"
                android:hint="Enter Name..."
                android:paddingHorizontal="12dp"
                android:singleLine="true"
                android:text="Sahil"
                android:textColor="#1A1A2E"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnGenerate"
                android:layout_width="0dp"
                android:layout_height="42dp"
                android:layout_weight="1.2"
                android:backgroundTint="#E8B4B8"
                android:text="✦ Generate"
                android:textAllCaps="false"
                android:textColor="#1A1A2E"
                android:textSize="13sp"
                android:textStyle="bold"
                app:cornerRadius="10dp" />
        </LinearLayout>

        <!-- Sub-Tabs -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/crunchSubTabs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- Options Panel (Shown on Options/Symbols mode) -->
    <LinearLayout
        android:id="@+id/crunchOptionsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="14dp"
        android:paddingTop="10dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etIntro"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editor_white"
                android:hint="Intro (optional)"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#1A1A2E"
                android:textSize="13sp" />

            <EditText
                android:id="@+id/etOutro"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:background="@drawable/bg_editor_white"
                android:hint="Outro (optional)"
                android:paddingHorizontal="10dp"
                android:singleLine="true"
                android:textColor="#1A1A2E"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbMixSymbols"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="Mix Combining Marks"
                android:textSize="12sp" />

            <CheckBox
                android:id="@+id/cbShuffle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:checked="false"
                android:text="Shuffle"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCrunch"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

</LinearLayout>
