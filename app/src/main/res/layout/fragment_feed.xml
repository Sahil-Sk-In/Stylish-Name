<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/feedRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5E6E8"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/feedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A2E"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvFeedTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Curated Feed &amp; Moments"
            android:textColor="#E8B4B8"
            android:textSize="20sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etFeedSearch"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_search_pill"
            android:hint="Search bios, quotes, tags..."
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:textColor="#1A1A2E"
            android:textColorHint="#6B7280"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tabPosts"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_selected"
                android:gravity="center"
                android:text="Posts (84)"
                android:textColor="#1A1A2E"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabMoments"
                android:layout_width="0dp"
                android:layout_height="34dp"
                android:layout_weight="1"
                android:background="@drawable/bg_tab_unselected"
                android:gravity="center"
                android:text="Moments (39)"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvFeed"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:padding="12dp" />

</LinearLayout>
